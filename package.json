{
  "name": "ts-signal",
  "version": "0.1.1",
  "description": "Typescript-safe signals with utility functions",
  "author": "Bart Huijgen",
  "repository": {
    "type": "git",
    "url": "https://github.com/barthuijgen/ts-signal.git"
  },
  "license": "MIT",
  "keywords": [
    "signal",
    "typescript",
    "Event",
    "EventEmitter"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && rolldown -c rolldown.config.ts",
    "test": "NODE_OPTIONS=\"--expose-gc\" vitest run",
    "test:coverage": "NODE_OPTIONS=\"--expose-gc\" vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "rolldown": "1.0.0-rc.9",
    "rolldown-plugin-dts": "^0.22.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20"
  }
}
